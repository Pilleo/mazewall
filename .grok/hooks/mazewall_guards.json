{
  "hooks": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/pre_invocation_sync.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/auto_memory_capture.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/auto_memory_capture.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
