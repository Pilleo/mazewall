{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jbcontext index --silent --only-incremental",
                        "async": true
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jbcontext index --silent --only-incremental",
                        "async": true
                    },
                    {
                        "type": "command",
                        "command": "jbcontext __session-end",
                        "async": true
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "jbcontext hook user-prompt-submit --mode prefetch",
                        "timeout": 180
                    }
                ]
            }
        ]
    }
}
