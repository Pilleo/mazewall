FROM eclipse-temurin:25-jdk

# Set up work directory
WORKDIR /workspace

# Install common utilities
RUN apt-get update && apt-get install -y \
    curl \
    git \
    strace \
    unzip \
    maven \
    zsh \
    && rm -rf /var/lib/apt/lists/*

# Configure Git to accept any directory to prevent dubious ownership errors in containerized builds
RUN git config --global --add safe.directory '*'

# The project uses Gradle Toolchains to download Java 25.
# Ensure the container has enough permissions to download and install toolchains.

# Default command
CMD ["./gradlew", "test"]
