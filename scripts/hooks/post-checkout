#!/usr/bin/env bash
# Git post-checkout hook
# Runs after checking out branches/commits.
# Safe in all environments: gracefully skips any tools that are not installed.

# Only run on branch/tree checkouts (flag $3 == 1), not file checkouts
if [ "${3:-0}" -ne 1 ]; then
    exit 0
fi

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Universal async indexer
if [ -x "$ROOT_DIR/scripts/git_async_indexer.sh" ]; then
    "$ROOT_DIR/scripts/git_async_indexer.sh" &
fi

# ADK-managed Codanna indexer
if [ -x "$ROOT_DIR/scripts/adk-codanna-reindex" ]; then
    "$ROOT_DIR/scripts/adk-codanna-reindex" || true
fi

# JetBrains Context semantic indexer
if [ -x "$ROOT_DIR/scripts/adk-jbcontext-reindex" ]; then
    "$ROOT_DIR/scripts/adk-jbcontext-reindex" || true
fi

exit 0
