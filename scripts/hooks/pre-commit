#!/usr/bin/env bash
# Git pre-commit hook to audit changes against mazewall security boundaries.
# This prevents agent loops or rogue code modifications from bypassing seccomp/Landlock rules.
#
# Section 1 semantics (v2):
#   A forbidden pattern is a VIOLATION only when the STAGED file contains MORE occurrences of the
#   pattern than the file at HEAD (net-new usage). Refactors that keep the occurrence count equal
#   or lower (e.g. replacing valueOf("X") with the equivalent enum reference X) are permitted.
#   Operators may additionally sanction specific file+pattern pairs via
#   .agents/security-audit-allowlist.txt (see that file for format); sanctioned violations produce
#   a loud WARNING instead of a failure. The allowlist is operator-owned: do not edit it as part
#   of agent-driven changes.

set -euo pipefail

echo "==> Auditing codebase changes for security exceptions and bypasses..."

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
ALLOWLIST_FILE="$ROOT_DIR/.agents/security-audit-allowlist.txt"

# 1. Check for unauthorized seccomp/bypass modifications in source files
FORBIDDEN_PATTERNS=(
  "FallbackBehavior.WARN_AND_BYPASS"
  "seccomp_filter_flag"
  "sun.misc.Unsafe"
)

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(kt|java)$' || true)

if [ -n "$CHANGED_FILES" ]; then
  for file in $CHANGED_FILES; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
      staged_count=$(git show ":$file" 2>/dev/null | grep -cE "$pattern" || true)
      head_count=$(git show "HEAD:$file" 2>/dev/null | grep -cE "$pattern" || true)

      if [ "$staged_count" -le "$head_count" ]; then
        continue  # no net-new occurrences: refactor/removal, not an introduction
      fi

      # Net-new occurrences: fail, unless the operator explicitly allowlisted this pair.
      if [ -f "$ALLOWLIST_FILE" ] && grep -vE '^\s*(#|$)' "$ALLOWLIST_FILE" \
           | while IFS= read -r entry; do
               entry_pattern="${entry%%::*}"
               entry_glob="${entry#*::}"; entry_glob="${entry_glob%%::*}"
               if [ "$entry_pattern" = "$pattern" ] && [[ "$file" == $entry_glob ]]; then
                 echo "true"
               fi
             done | grep -q "true"; then
        echo "WARNING: Sanctioned by $ALLOWLIST_FILE: '$pattern' net-new in $file."
        echo "         Ensure this change was reviewed and approved by an operator."
      else
        echo "ERROR: Security violation in $file. Detected disallowed pattern: '$pattern'"
        echo "Agents are not permitted to modify core fallback behaviors or use raw Unsafe memory directly."
        echo "(Staged occurrences: $staged_count, HEAD occurrences: $head_count)"
        exit 1
      fi
    done
  done
fi

# 2. Check for modifications to the core filter engine
CORE_FILES=$(git diff --cached --name-only | grep -E 'BpfFilter\.kt|LinuxNative\.kt' || true)
if [ -n "$CORE_FILES" ]; then
  echo "WARNING: Modifications to core security engine files detected: $CORE_FILES"
  echo "Please ensure these changes are fully validated through './gradlew build'."
fi

# 3. Run the full build, including formatting, static analysis, tests and coverage.
# Full log kept at /tmp/mazewall-precommit-test.log: intermittent failures have occurred that
# leave no trace in result XMLs (issue-20260823-172001 watch item) — always capture the run.

# Portal tests are part of the commit gate when :portals:runtime participates in the build.
# Inclusion is read directly from settings.gradle.kts: probing via './gradlew projects'
# would cost two full Gradle configuration passes per commit for statically known facts.
BUILD_TASKS=("build")
if grep -Eq '^[[:space:]]*include\(":portals:runtime"\)' "$ROOT_DIR/settings.gradle.kts"; then
  BUILD_TASKS+=(":portals:runtime:integrationTest" ":portals:runtime:test")
else
  # Explicit operator exclusion (like :tools:orchestrator) must stay visible,
  # never silent: skipping the gate segment without notice is a bypass.
  echo "!!! GATE DEGRADED: ':portals:runtime' is not included in settings.gradle.kts."
  echo "!!! Committing WITHOUT :portals:runtime integration tests. Re-include before merging."
fi

echo "==> Running the full Gradle build and portal integration tests..."
echo "==> Build tasks to run: ${BUILD_TASKS[*]}"
# Gradle test workers write module-local binary result files.  Concurrent commit hooks
# in this checkout can otherwise race on those files and surface as EOF/missing-result
# failures unrelated to either change.  Serialize only this shared-output gate.
PRECOMMIT_TEST_LOCK=/tmp/mazewall-precommit-test.lock
if ! (
  # Audits above need the committing repository's Git context. Gradle tests may
  # operate on foreign repositories, so drop only Git's repository-local names
  # in this subprocess; preserve the hook context and all other environment.
  GIT_LOCAL_ENV_VARS=$(git rev-parse --local-env-vars) || exit $?
  for name in $GIT_LOCAL_ENV_VARS; do
    unset "$name" || exit $?
  done
  flock -w 900 "$PRECOMMIT_TEST_LOCK" \
    ./gradlew "${BUILD_TASKS[@]}" --no-configuration-cache --no-parallel
) > /tmp/mazewall-precommit-test.log 2>&1; then
  echo "--- Failing tests ---"
  grep -E "FAILED$|FAILED |e: " /tmp/mazewall-precommit-test.log | head -20 || true
  echo "-------------------"
  echo "ERROR: Full Gradle build failed. Commit aborted. Full log: /tmp/mazewall-precommit-test.log"
  exit 1
fi

# 4. Optional AST-grep structural verification (cleanly skips if ast-grep is unavailable)
AST_GREP_BIN=""
if [ -f "$ROOT_DIR/scripts/find-tool.sh" ]; then
  # shellcheck source=scripts/find-tool.sh
  source "$ROOT_DIR/scripts/find-tool.sh"
  AST_GREP_BIN="$(find_ast_grep 2>/dev/null || true)"
elif command -v ast-grep >/dev/null 2>&1; then
  AST_GREP_BIN="$(command -v ast-grep)"
fi

if [ -n "$AST_GREP_BIN" ] && [ -x "$AST_GREP_BIN" ] && [ -f "$ROOT_DIR/sgconfig.yml" ]; then
  echo "==> Running AST-level structural checks (ast-grep)..."
  "$AST_GREP_BIN" scan --no-repo-update || true
fi

# 5. Keep Codanna code atlas index fresh (optional, non-blocking background refresh)
CODANNA_BIN=""
if [ -f "$ROOT_DIR/scripts/find-tool.sh" ]; then
  CODANNA_BIN="$(find_codanna 2>/dev/null || true)"
elif command -v codanna >/dev/null 2>&1; then
  CODANNA_BIN="$(command -v codanna)"
fi

if [ -n "$CODANNA_BIN" ] && [ -x "$CODANNA_BIN" ] && [ -f "$ROOT_DIR/.codanna/settings.toml" ]; then
  echo "==> Refreshing Codanna code atlas index (background)..."
  (
    cd "$ROOT_DIR"
    nohup "$CODANNA_BIN" index . --no-progress >/dev/null 2>&1 &
    touch "$ROOT_DIR/.codanna/.last_indexed" 2>/dev/null || true
  ) 2>/dev/null || true
fi

echo "==> Security audit and full Gradle build passed successfully."
exit 0
