{
    "agent-context-sync": {
        "PreInvocation": [
            {
                "type": "command",
                "command": "./scripts/pre_invocation_sync.py",
                "timeout": 5
            }
        ],
        "PostToolUse": [
            {
                "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./scripts/compiler_guard.py",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": "./scripts/auto_memory_capture.py",
                "timeout": 10
            }
        ]
    },
    "adk-guard": {
        "PostToolUse": [
            {
                "matcher": "replace_file_content|multi_replace_file_content|write_to_file|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./scripts/adkw hook --harness antigravity --file \"{file}\"",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
