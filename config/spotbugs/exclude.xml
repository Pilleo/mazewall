<?xml version="1.0" encoding="UTF-8" ?>
<FindBugsFilter>
    <Match>
        <Class name="~.*" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
    </Match>

    <!-- SpotBugs incorrectly flags the static engine field modification as a bug.
         This is intentional for testability (fault injection). -->
    <Match>
        <Class name="io.mazewall.LinuxNative" />
        <Or>
            <Method name="setEngine" />
            <Method name="resetToDefault" />
            <Method name="setTransactionManager" />
            <Method name="resetTransactionManager" />
        </Or>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="io.mazewall.Platform" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="io.mazewall.RealPlatformProvider" />
        <Or>
            <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
            <Bug pattern="MS_CANNOT_BE_FINAL" />
            <Bug pattern="MS_SHOULD_BE_FINAL" />
        </Or>
    </Match>
    <Match>
        <Class name="io.mazewall.PlatformDiagnosticsTest" />
    </Match>
    <Match>
        <Class name="~io\.mazewall\.enforcer\.supervisor\.SupervisorSessionHandler.*" />
        <Bug pattern="DE_MIGHT_IGNORE" />
    </Match>
    <Match>
        <Or>
            <Class name="io.mazewall.orchestrator.GitHubCli" />
            <Class name="io.mazewall.orchestrator.JulesCli" />
        </Or>
        <Method name="init" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <!-- SpotBugs false positive: the bounded LRU is an anonymous LinkedHashMap subclass
         (access-order eviction, issue-20260823-171953). get/remove are invoked via
         Map interface call sites, which the analyzer cannot see for anonymous classes. -->
    <Match>
        <Class name="~io\.mazewall\.PolicyCompilationCache.*" />
        <Or>
            <Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS" />
            <Bug pattern="UMAC" />
        </Or>
    </Match>

    <Match>
        <Class name="io.mazewall.MockNativeEngine" />
    </Match>
    <Match>
        <Class name="io.mazewall.MockNativeProcess" />
    </Match>
    <Match>
        <Class name="~io\.mazewall\.testing\.TestSuiteHealthListener.*" />
    </Match>
</FindBugsFilter>
