<?xml version="1.0" encoding="UTF-8" ?>
<FindBugsFilter>
    <!-- Global exclusions for Kotlin data classes -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
    </Match>
    <!-- SpotBugs incorrectly flags the static engine field modification as a bug.
         This is intentional for testability (fault injection). -->
    <Match>
        <Class name="io.mazewall.platform.native.LinuxNative" />
        <Or>
            <Method name="setEngine" />
            <Method name="resetToDefault" />
            <Method name="setTransactionManager" />
            <Method name="resetTransactionManager" />
        </Or>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="io.mazewall.enforcer.api.Platform" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="io.mazewall.enforcer.internal.ffi.RealPlatformProvider" />
        <Or>
            <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
            <Bug pattern="MS_CANNOT_BE_FINAL" />
            <Bug pattern="MS_SHOULD_BE_FINAL" />
        </Or>
    </Match>
    <Match>
        <Class name="io.mazewall.PlatformDiagnosticsTest" />
    </Match>
    <Match>
        <Class name="~io\.mazewall\.enforcer\.supervisor\.SupervisorSessionHandler.*" />
        <Bug pattern="DE_MIGHT_IGNORE" />
    </Match>
    <Match>
        <Or>
            <Class name="io.mazewall.orchestrator.GitHubCli" />
            <Class name="io.mazewall.orchestrator.JulesCli" />
        </Or>
        <Method name="init" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <!-- SpotBugs false positive: the bounded LRU is an anonymous LinkedHashMap subclass
         (access-order eviction, issue-20260823-171953). get/remove are invoked via
         Map interface call sites, which the analyzer cannot see for anonymous classes. -->
    <Match>
        <Class name="~io\.mazewall\.enforcer\.api\.PolicyCompilationCache.*" />
        <Or>
            <Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS" />
            <Bug pattern="UMAC" />
        </Or>
    </Match>
    <!-- This exact bridge preserves legacy catch compatibility; renaming or removing
         its superclass relationship would break the supported API. -->
    <Match>
        <Class name="io.mazewall.enforcer.api.ContainmentViolationException" />
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS" />
    </Match>
    <!-- Kotlin object accessors intentionally configure these singleton seams.
         Keep every other field and bug category analyzed. -->
    <Match>
        <Class name="io.mazewall.enforcer.diagnostics.MazewallEvents" />
        <Field name="failOnListenerError" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="io.mazewall.profiler.internal.engine.ProfilerDaemon" />
        <Field name="runner" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="io.mazewall.profiler.iterative.IterativeProfiler" />
        <Field name="taskExecutor" />
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD" />
    </Match>
    <Match>
        <Class name="~io\.mazewall\.testing\.TestSuiteHealthListener.*" />
    </Match>
    <Match>
        <Class name="~io\.mazewall\.MockNativeEngine.*" />
    </Match>
    <Match>
        <Class name="~io\.mazewall\.MockNativeProcess.*" />
    </Match>
</FindBugsFilter>
