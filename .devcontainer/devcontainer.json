{
  "name": "jseccomp Dev Environment",
  "build": {
    "dockerfile": "../infra/dev/Containerfile",
    "context": "..",
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": [
    "--userns=keep-id",
    "--user=${localEnv:MAZEWALL_UID}:${localEnv:MAZEWALL_GID}",
    "--mount=source=${localEnv:MAZEWALL_CONTAINER_CACHE_DIR},target=/container-gradle-home,type=bind",
    "--security-opt=seccomp=${localWorkspaceFolder}/infra/dev/podman-seccomp.json",
  ],
  "remoteEnv": {
    "JAVA_HOME": "/opt/java/openjdk",
    "HOME": "/tmp",
    "GRADLE_USER_HOME": "/container-gradle-home",
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "fwcd.kotlin",
      ],
    },
  },
}
